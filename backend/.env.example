# Servidor
PORT=5088
# URL pública do front-end, usada para montar links de email (ex.: redefinir senha)
FRONTEND_URL=http://localhost:5173

# Postgres (Supabase) — pooler transaction mode (6543) para runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Pooler session mode (5432) — usado por `prisma migrate`/`db push`
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase (Storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=uploads

# JWT
JWT_ISSUER=aio
JWT_AUDIENCE=aio-web
JWT_SIGNING_KEY=change-me-in-production
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# CORS — origens adicionais liberadas além de localhost/127.0.0.1 (separadas por vírgula)
CORS_ORIGINS=https://your-app.vercel.app
